generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Utilisateurs et Authentification
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String?
  firstName     String?
  lastName      String?
  avatar        String?
  role          Role      @default(USER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  projects      ProjectMember[]
  contents      Content[]
  campaigns     Campaign[]
  comments      Comment[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@map("users")
}

enum Role {
  USER
  ADMIN
  OWNER
}

// OAuth Accounts (Google, GitHub, etc.)
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// Sessions
model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  userAgent    String?
  ip           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Vérification d'email
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Projets
model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  color       String?  @default("#3B82F6")
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  owner       User            @relation(fields: [ownerId], references: [id])
  members     ProjectMember[]
  campaigns   Campaign[]
  contents    Content[]
  auditLogs   AuditLog[]

  @@map("projects")
}

// Membres de projet
model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// Campagnes marketing
model Campaign {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      CampaignStatus @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  budget      Float?
  currency    String   @default("EUR")
  projectId   String
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  project     Project   @relation(fields: [projectId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  contents    Content[]
  metrics     CampaignMetric[]

  @@map("campaigns")
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

// Métriques de campagne
model CampaignMetric {
  id          String   @id @default(uuid())
  campaignId  String
  date        DateTime
  impressions Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  spend       Float    @default(0)
  revenue     Float    @default(0)
  createdAt   DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@map("campaign_metrics")
}

// Contenu généré par IA
model Content {
  id          String   @id @default(uuid())
  title       String
  content     String   @db.Text
  type        ContentType
  status      ContentStatus @default(DRAFT)
  platform    Platform?
  tone        String?
  language    String   @default("fr")
  length      ContentLength @default(MEDIUM)
  keywords    String[]
  metadata    Json?
  
  // IA
  modelUsed   String?
  promptUsed  String?  @db.Text
  tokensUsed  Int?
  
  // Planning
  scheduledAt DateTime?
  publishedAt DateTime?
  
  // Relations
  projectId   String?
  campaignId  String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  project     Project?  @relation(fields: [projectId], references: [id])
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  comments    Comment[]
  versions    ContentVersion[]
  approvals   ContentApproval[]

  @@index([projectId])
  @@index([campaignId])
  @@index([status])
  @@index([scheduledAt])
  @@map("contents")
}

enum ContentType {
  POST_LINKEDIN
  POST_TWITTER
  POST_FACEBOOK
  POST_INSTAGRAM
  ARTICLE_BLOG
  EMAIL_NEWSLETTER
  AD_COPY
  VIDEO_SCRIPT
  CAPTION
  OTHER
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum Platform {
  LINKEDIN
  TWITTER
  FACEBOOK
  INSTAGRAM
  TIKTOK
  YOUTUBE
  BLOG
  EMAIL
}

enum ContentLength {
  SHORT
  MEDIUM
  LONG
}

// Versions de contenu
model ContentVersion {
  id        String   @id @default(uuid())
  contentId String
  version   Int
  content   String   @db.Text
  changes   String?
  userId    String
  createdAt DateTime @default(now())

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, version])
  @@map("content_versions")
}

// Approbations de contenu
model ContentApproval {
  id        String   @id @default(uuid())
  contentId String
  userId    String
  status    ApprovalStatus
  comment   String?
  createdAt DateTime @default(now())

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([contentId, userId])
  @@map("content_approvals")
}

enum ApprovalStatus {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

// Commentaires
model Comment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  contentId String
  userId    String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])
  parent  Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@index([contentId])
  @@map("comments")
}

// Templates de prompts IA
model PromptTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String
  prompt      String   @db.Text
  variables   String[]
  isPublic    Boolean  @default(false)
  isPremium   Boolean  @default(false)
  usageCount  Int      @default(0)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@map("prompt_templates")
}

// Crédits / Quotas IA
model CreditUsage {
  id        String   @id @default(uuid())
  userId    String
  action    String
  credits   Int
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("credit_usage")
}

// Abonnements Stripe
model Subscription {
  id             String   @id @default(uuid())
  userId         String   @unique
  stripeCustomerId String? @unique
  stripeSubscriptionId String? @unique
  plan           PlanType @default(FREE)
  status         SubscriptionStatus @default(INACTIVE)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean  @default(false)
  canceledAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("subscriptions")
}

enum PlanType {
  FREE
  STARTER
  PRO
  AGENCY
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  TRIALING
  CANCELED
  PAST_DUE
}

// Notifications
model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String   @db.Text
  type      NotificationType
  isRead    Boolean  @default(false)
  link      String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  CONTENT_APPROVED
  CONTENT_REJECTED
  COMMENT_ADDED
  REMINDER
}

// Logs d'audit
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  projectId String?
  changes   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Intégrations externes (Buffer, Hootsuite, etc.)
model Integration {
  id           String   @id @default(uuid())
  userId       String
  provider     IntegrationProvider
  accessToken  String   @db.Text
  refreshToken String?  @db.Text
  expiresAt    DateTime?
  scopes       String[]
  isActive     Boolean  @default(true)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, provider])
  @@map("integrations")
}

enum IntegrationProvider {
  BUFFER
  HOOTSUITE
  LINKEDIN
  TWITTER
  FACEBOOK
  INSTAGRAM
  SLACK
}

// Paramètres globaux
model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}
